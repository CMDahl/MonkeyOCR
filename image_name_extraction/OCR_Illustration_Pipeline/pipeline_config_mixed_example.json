{
  "pipeline_name": "OCR Illustration Pipeline - Mixed Mode Example",
  "version": "1.0",
  "description": "Example configuration combining specific files and folder scanning",
  
  "paths": {
    "output_directory": "C:\\Users\\iu2-cmd\\GitHub\\MonkeyOCR\\image_name_extraction\\test",
    "python_executable": "C:\\Users\\iu2-cmd\\AppData\\Local\\miniconda3\\envs\\OCR-Parser\\python.exe",
    "original_images_path": "V:\\BDADShareData2\\HCNC\\norway\\biographies\\raw\\corpus"
  },
  
  "input": {
    "mode": "mixed",
    "description": "Combine specific important files with folder scanning for additional content",
    
    "files": [
      "C:\\important\\biography_001.md",
      "C:\\important\\biography_002.md"
    ],
    
    "folders": [
      {
        "path": "C:\\Users\\iu2-cmd\\GitHub\\ocr-pipeline-paddle-deepseek\\output_paddleOCR\\digibok_2007031501007",
        "pattern": "**/*.md",
        "recursive": true,
        "description": "Add all files from main collection"
      }
    ],
    
    "filters": {
      "exclude_patterns": [
        "*_test*"
      ],
      "min_file_size_bytes": 50,
      "max_files": 100,
      "description": "Limit to first 100 files for testing"
    }
  },
  
  "pipeline_steps": {
    "1_portrait_association": {
      "enabled": true,
      "suppress_stderr": true,
      "description": "Associate portraits with names using Gemini AI"
    },
    "2_concatenate_markdown": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Combine all markdown files into one"
    },
    "3_extract_names_gemini": {
      "enabled": true,
      "suppress_stderr": true,
      "description": "Extract all biographical names using Gemini"
    },
    "4_extract_names_chunks": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Extract names with text chunks"
    },
    "5_merge_portraits": {
      "enabled": true,
      "suppress_stderr": true,
      "description": "Merge portrait associations into CSV"
    },
    "6_extract_biographies": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Extract structured biographical data"
    },
    "7_collect_data": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Collect final statistics"
    },
    "8_visualize": {
      "enabled": false,
      "suppress_stderr": false,
      "description": "Skip visualization for large batches"
    }
  },
  
  "output_files": {
    "staging_folder": "input_staging",
    "concatenated_markdown": "all_biographies.md",
    "gemini_names_json": "gemini_all_names.json",
    "names_csv": "all_names.csv",
    "final_dataset": "final_dataset.csv",
    "visualization_folder": "test_images"
  }
}
