{
  "pipeline_name": "OCR Illustration Pipeline - Folder Scanning Example",
  "version": "1.0",
  "description": "Example configuration for processing all markdown files in specific folders",
  
  "paths": {
    "output_directory": "C:\\Users\\iu2-cmd\\GitHub\\MonkeyOCR\\image_name_extraction\\test",
    "python_executable": "C:\\Users\\iu2-cmd\\AppData\\Local\\miniconda3\\envs\\OCR-Parser\\python.exe",
    "original_images_path": "V:\\BDADShareData2\\HCNC\\norway\\biographies\\raw\\corpus"
  },
  
  "azure_keyvault": {
    "vault_url": "https://rmaocr.vault.azure.net/",
    "gemini_api_key_name": "AMDGeminiFlashKey",
    "description": "Azure Key Vault configuration for API keys. Requires Azure CLI authentication (az login)."
  },
  
  "input": {
    "mode": "folders",
    "description": "Scan entire directories for markdown files",
    
    "files": [],
    
    "folders": [
      {
        "path": "C:\\Users\\iu2-cmd\\GitHub\\ocr-pipeline-paddle-deepseek\\output_paddleOCR\\digibok_2007031501007",
        "pattern": "**/*.md",
        "recursive": true,
        "description": "Process all biographies from book collection 2007031501007"
      },
      {
        "path": "C:\\Users\\iu2-cmd\\GitHub\\ocr-pipeline-paddle-deepseek\\output_paddleOCR\\digibok_2011052606015",
        "pattern": "**/*.md",
        "recursive": true,
        "description": "Process all biographies from book collection 2011052606015"
      }
    ],
    
    "filters": {
      "exclude_patterns": [
        "*_backup*",
        "*_temp*",
        "*_draft*"
      ],
      "min_file_size_bytes": 100,
      "max_files": null,
      "description": "Process all files except backups, with minimum 100 bytes"
    }
  },
  
  "pipeline_steps": {
    "1_portrait_association": {
      "enabled": true,
      "suppress_stderr": true,
      "description": "Associate portraits with names using Gemini AI"
    },
    "2_concatenate_markdown": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Combine all markdown files into one"
