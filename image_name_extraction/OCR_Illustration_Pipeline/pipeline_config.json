{
  "pipeline_name": "OCR Illustration Pipeline",
  "version": "1.0",
  
  "paths": {
    "output_directory": "V:\\BDADShareData2\\HCNC\\norway\\biographies\\storage\\paddleocr",
    "python_executable": "C:\\Users\\iu2-cmd\\AppData\\Local\\miniconda3\\envs\\OCR-Parser\\python.exe",
    "original_images_path": "D:\\models\\LLMs\\hub\\test_data\\sample"
  },
  
  "azure_keyvault": {
    "vault_url": "https://rmaocr.vault.azure.net/",
    "gemini_api_key_name": "SDUGeminiAPI",
    "description": "Azure Key Vault configuration for API keys. Requires Azure CLI authentication (az login)."
  },
  
  "input": {
    "mode": "folders",
    "description": "Scan entire directories for markdown files",
    
    "files": [],
    
    "folders": [
      {
        "path": "D:\\models\\LLMs\\hub\\paddle_output\\sample",
        "pattern": "**/*.md",
        "recursive": true,
        "description": "Process all biographies from book collection sample"
      }
    ],
    
    "filters": {
      "exclude_patterns": [
        "*_backup*",
        "*_temp*",
        "*_draft*"
      ],
      "min_file_size_bytes": 100,
      "max_files": null,
      "description": "Process all files except backups, with minimum 100 bytes"
    }
  },
  
  "pipeline_steps": {
    "1_portrait_association": {
      "enabled": true,
      "suppress_stderr": true,
      "description": "Associate portraits with names using Gemini AI"
    },
    "2_concatenate_markdown": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Combine all markdown files into one"
    },
    "3_extract_names_gemini": {
      "enabled": true,
      "suppress_stderr": true,
      "description": "Extract all biographical names using Gemini"
    },
    "4_extract_names_chunks": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Extract names with text chunks"
    },
    "5_merge_portraits": {
      "enabled": true,
      "suppress_stderr": true,
      "description": "Merge portrait associations into CSV"
    },
    "6_extract_biographies": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Extract structured biographical data"
    },
    "7_collect_data": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Collect final statistics"
    },
    "8_visualize": {
      "enabled": true,
      "suppress_stderr": false,
      "description": "Generate quality inspection visualizations"
    }
  },
  
  "output_files": {
    "staging_folder": "input_staging",
    "concatenated_markdown": "all_biographies.md",
    "gemini_names_json": "gemini_all_names.json",
    "names_csv": "all_names.csv",
    "final_dataset": "final_dataset.csv",
    "visualization_folder": "test_images"
  },
  
  "portrait_handling": {
    "multiple_portraits_per_person": "all",
    "separator": "|",
    "description": "How to handle multiple portraits for the same person. Options: 'all' (comma-separated list), 'first' (first portrait only), 'last' (last portrait only), 'primary' (highest confidence)"
  }
}
